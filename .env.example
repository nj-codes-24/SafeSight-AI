# SafeSight AI needs no secrets or API keys. Nothing reads a .env file automatically.
# These are the environment variables the project uses; launch.py sets the first two for you.

# Where Ultralytics keeps its settings (kept inside the project, git-ignored).
YOLO_CONFIG_DIR=.ultralytics
# Prevent Ultralytics from contacting the internet at runtime.
YOLO_OFFLINE=true

# Browser QA scripts (scripts/qa/) only:
# SAFESIGHT_URL=http://localhost:8501
# SAFESIGHT_EDGE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
